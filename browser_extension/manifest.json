{
  "manifest_version": 3,
  "name": "MacroRelay Deck URL Presets",
  "version": "1.0.9",
  "description": "Connects Deck presets and Studio element actions with open browser tabs.",
  "permissions": ["tabs", "webNavigation", "storage", "alarms", "scripting", "debugger"],
  "host_permissions": ["http://127.0.0.1:18773/*", "http://127.0.0.1:18774/*", "http://127.0.0.1:18775/*", "http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html"
}
